**/__pycache__/
app-mobile/.expo/
app-mobile/ios/
app-mobile/android/
app-mobile/dist/
app-mobile/web-build/
app-mobile/targets/widget/Assets.xcassets/
app-mobile/targets/widget/Config.generated.swift
