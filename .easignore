# Cosa caricare su EAS Build. Si usa con EAS_NO_VCS=1 perche'
# app-mobile/src/config.ts (indirizzo e token del backend) e' fuori da git ma
# serve alla build dell'app e dei widget. Il backend non serve alla build e
# contiene segreti: resta fuori tutto.
